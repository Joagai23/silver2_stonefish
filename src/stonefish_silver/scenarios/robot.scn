
<?xml version="1.0"?>
<scenario>
    <!-- Physical materials -->
    <materials>
        <material name="LightAluminium" density="100.0" restitution="0.8"/>
    </materials>
    
    <!-- Graphical materials -->
    <looks>
        <look name="Silver" rgb="1.0 1.0 1.0" roughness="1.0" texture="silver_uv.png"/>
    </looks>

    <!--
        TO DO:
            - Change Joint Type to Revolute
    -->

    <!-- Robot Definition -->
    <robot name="$(arg silver_robot)" fixed="false" self_collisions="false">     
        <!-- Main Body -->
        <world_transform xyz="0.0 0.0 -1.5" rpy="0.0 0.0 0.0"/>
        <base_link name="MainBody" type="model" physics="submerged">
            <physical>
                <mesh filename="Body.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </base_link>
        
        <!-- Leg 0 -->
        <!-- Coxa L0 -->
        <link name="Coxa_L0" type="model" physics="submerged">
            <physical>
                <mesh filename="Coxa.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L0_Coxa" type="fixed">
            <parent name="MainBody"/>
            <child name="Coxa_L0"/>
            <origin xyz="1.62 0.98 0.28" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <!-- Femur L0 -->
        <link name="Femur_L0" type="model" physics="submerged">
            <physical>
                <mesh filename="Femur.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L0_Femur" type="fixed">
            <parent name="Coxa_L0"/>
            <child name="Femur_L0"/>
            <origin xyz="0.55 0.01 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <!-- Tibia L0 -->
        <link name="Tibia_L0" type="model" physics="submerged">
            <physical>
                <mesh filename="Tibia.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L0_Tibia" type="fixed">
            <parent name="Femur_L0"/>
            <child name="Tibia_L0"/>
            <origin xyz="1.85 -0.04 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <!-- Leg 1 -->
        <!-- Coxa L1 -->
        <link name="Coxa_L1" type="model" physics="submerged">
            <physical>
                <mesh filename="Coxa.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L1_Coxa" type="fixed">
