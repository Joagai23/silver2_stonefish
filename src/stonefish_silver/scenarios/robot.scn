                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L3_Tibia" type="fixed">
            <parent name="Femur_L3"/>
            <child name="Tibia_L3"/>
            <origin xyz="1.85 -0.03 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <!-- Leg 4 -->
        <!-- Coxa L4 -->
        <link name="Coxa_L4" type="model" physics="submerged">
            <physical>
                <mesh filename="Coxa_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="LightAluminium"/>
            <look name="Silver"/>
        </link>
        <joint name="Joint_L4_Coxa" type="fixed">
            <parent name="MainBody"/>
            <child name="Coxa_L4"/>
            <origin xyz="-1.62 -0.15 0.28" rpy="0.0 0.0 3.14"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <!-- Femur L4 -->
        <link name="Femur_L4" type="model" physics="submerged">
            <physical>
                <mesh filename="Femur_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
