<?xml version="1.0"?>
<scenario>
    <!-- Robot Definition -->
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">     
        <!-- Main Body -->
        <world_transform xyz="0.0 0.0 -1.5" rpy="0.0 0.0 0.0"/>
        <base_link name="MainBody" type="model" physics="surface">
            <physical>
                <mesh filename="Body.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="140.0"/>
            <inertia xyz="2.91 4.58 5.40"/>
            <cg xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </base_link>


        <!-- Leg 0 -->
        <!-- Coxa L0 -->
        <link name="Coxa_L0" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/>
        </link>
        <joint name="Joint_L0_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L0"/>
            <origin xyz="1.62 0.98 0.28" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L0_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L0_Coxa"/>
            <initial position="0.75"/>
        </actuator>
        <!-- Femur L0 -->
        <link name="Femur_L0" type="model" physics="surface">
            <physical>
                <mesh filename="Femur.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L0_Femur" type="revolute">
            <parent name="Coxa_L0"/>
            <child name="Femur_L0"/>
            <origin xyz="0.55 0.01 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L0_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L0_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L0 -->
        <link name="Tibia_L0" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L0_Tibia" type="revolute">
            <parent name="Femur_L0"/>
            <child name="Tibia_L0"/>
            <origin xyz="1.85 -0.04 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L0_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L0_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Leg 1 -->
        <!-- Coxa L1 -->
        <link name="Coxa_L1" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/>
        </link>
        <joint name="Joint_L1_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L1"/>
            <origin xyz="1.62 -0.15 0.28" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L1_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L1_Coxa"/>
            <initial position="0.0"/>
        </actuator>
        <!-- Femur L1 -->
        <link name="Femur_L1" type="model" physics="surface">
            <physical>
                <mesh filename="Femur.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L1_Femur" type="revolute">
            <parent name="Coxa_L1"/>
            <child name="Femur_L1"/>
            <origin xyz="0.55 0.01 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L1_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L1_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L1 -->
        <link name="Tibia_L1" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L1_Tibia" type="revolute">
            <parent name="Femur_L1"/>
            <child name="Tibia_L1"/>
            <origin xyz="1.85 -0.04 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L1_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L1_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Leg 2 -->
        <!-- Coxa L2 -->
        <link name="Coxa_L2" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/>
        </link>
        <joint name="Joint_L2_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L2"/>
            <origin xyz="1.62 -1.27 0.28" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L2_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L2_Coxa"/>
            <initial position="-0.75"/>
        </actuator>
        <!-- Femur L2 -->
        <link name="Femur_L2" type="model" physics="surface">
            <physical>
                <mesh filename="Femur_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L2_Femur" type="revolute">
            <parent name="Coxa_L2"/>
            <child name="Femur_L2"/>
            <origin xyz="0.55 0.05 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L2_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L2_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L2 -->
        <link name="Tibia_L2" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L2_Tibia" type="revolute">
            <parent name="Femur_L2"/>
            <child name="Tibia_L2"/>
            <origin xyz="1.85 -0.03 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L2_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L2_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Leg 3 -->
        <!-- Coxa L3 -->
        <link name="Coxa_L3" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/>
        </link>
        <joint name="Joint_L3_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L3"/>
            <origin xyz="-1.62 0.98 0.28" rpy="0.0 0.0 3.14"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L3_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L3_Coxa"/>
            <initial position="-0.75"/>
        </actuator>
        <!-- Femur L3 -->
        <link name="Femur_L3" type="model" physics="surface">
            <physical>
                <mesh filename="Femur_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L3_Femur" type="revolute">
            <parent name="Coxa_L3"/>
            <child name="Femur_L3"/>
            <origin xyz="0.55 0.05 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L3_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L3_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L3 -->
        <link name="Tibia_L3" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L3_Tibia" type="revolute">
            <parent name="Femur_L3"/>
            <child name="Tibia_L3"/>
            <origin xyz="1.85 -0.03 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L3_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L3_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Leg 4 -->
        <!-- Coxa L4 -->
        <link name="Coxa_L4" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/>
        </link>
        <joint name="Joint_L4_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L4"/>
            <origin xyz="-1.62 -0.15 0.28" rpy="0.0 0.0 3.14"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L4_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L4_Coxa"/>
            <initial position="0.0"/>
        </actuator>
        <!-- Femur L4 -->
        <link name="Femur_L4" type="model" physics="surface">
            <physical>
                <mesh filename="Femur_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L4_Femur" type="revolute">
            <parent name="Coxa_L4"/>
            <child name="Femur_L4"/>
            <origin xyz="0.55 0.05 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L4_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L4_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L4 -->
        <link name="Tibia_L4" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L4_Tibia" type="revolute">
            <parent name="Femur_L4"/>
            <child name="Tibia_L4"/>
            <origin xyz="1.85 -0.03 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L4_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L4_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Leg 5 -->
        <!-- Coxa L5 -->
        <link name="Coxa_L5" type="model" physics="surface">
            <physical>
                <mesh filename="Coxa.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.301"/>
            <inertia xyz="0.075 0.075 0.0875"/> 
        </link>
        <joint name="Joint_L5_Coxa" type="revolute">
            <parent name="MainBody"/>
            <child name="Coxa_L5"/>
            <origin xyz="-1.62 -1.27 0.28" rpy="0.0 0.0 3.14"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
        <actuator name="Servo_L5_Coxa" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L5_Coxa"/>
            <initial position="0.75"/>
        </actuator>
        <!-- Femur L5 -->
        <link name="Femur_L5" type="model" physics="surface">
            <physical>
                <mesh filename="Femur.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.501"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L5_Femur" type="revolute">
            <parent name="Coxa_L5"/>
            <child name="Femur_L5"/>
            <origin xyz="0.55 0.01 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L5_Femur" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L5_Femur"/>
            <initial position="0.8"/>
        </actuator>
        <!-- Tibia L5 -->
        <link name="Tibia_L5" type="model" physics="surface">
            <physical>
                <mesh filename="Tibia.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <material name="Fiberglass"/>
            <look name="Silver"/>
            <mass value="0.401"/>
            <inertia xyz="0.1 0.05 0.1"/>
        </link>
        <joint name="Joint_L5_Tibia" type="revolute">
            <parent name="Femur_L5"/>
            <child name="Tibia_L5"/>
            <origin xyz="1.85 -0.04 0.23" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <actuator name="Servo_L5_Tibia" type="servo">
            <controller position_gain="$(arg servo_pos_gain)" velocity_gain="1.0" max_torque="$(arg servo_max_torque)" max_velocity="$(arg servo_max_vel)"/>
            <joint name="Joint_L5_Tibia"/>
            <initial position="-2.3"/>
        </actuator>

        <!-- Rename publisher to "/joint_states" to mimic "ros2_control" functionality-->
        <ros_publisher servos="/joint_states"/>
        <ros_subscriber servos="/joint_setpoints"/>
    </robot>
</scenario>