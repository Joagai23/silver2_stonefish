<scenario>
    <!-- Physical materials -->
    <materials>
        <material name="LightAluminium" density="100.0" restitution="0.8"/>
        <material name="Steel" density="7891.0" restitution="0.9"/>
        <friction_table>
            <friction material1="LightAluminium" material2="LightAluminium" static="0.7" dynamic="0.5"/>
            <friction material1="Steel" material2="Steel" static="0.4" dynamic="0.2"/>
            <friction material1="LightAluminium" material2="Steel" static="0.6" dynamic="0.4"/>
        </friction_table>
    </materials>
    
    <!-- Graphical materials -->
    <looks>
        <look name="Gray" gray="0.5" roughness="0.3" metalness="0.2"/>
        <look name="Red" rgb="1.0 0.0 0.0" roughness="0.1"/>
        <look name="Sand" rgb="0.7 0.7 0.5" roughness="0.9" normal_map="sand_normal.png"/>
        <look name="Silver" rgb="1.0 1.0 1.0" roughness="1.0" texture="silver_uv.png"/>
    </looks>
    
    <!-- Create environment -->
    <environment> 
        <ned latitude="40.0" longitude="3.0"/>
        <!--
        <ocean>
            <water density="1031.0" jerlov="0.2" temperature="15.0"/>
            <waves height="0.0"/>
            <particles enabled="true"/>
        </ocean>
        -->
        <atmosphere>
            <sun azimuth="20.0" elevation="50.0"/>
        </atmosphere>
    </environment>


    <!-- Create lights-->
    <light name="Omni">
        <specs radius="0.2" illuminance="10000.0"/>
        <color rgb="0.2 0.3 1.0"/>
        <world_transform xyz="1.0 5.0 -10.0" rpy="0.0 0.0 0.0"/>
    </light>

    <!-- Create terrain-->
    <static name="Seabed" type="terrain">
        <height_map filename="terrain.png"/>
        <dimensions scalex="1.0" scaley="1.0" height="5.0"/>
        <material name="Steel"/>
        <look name="Sand" uv_scale="5.0"/>
        <world_transform xyz="0.0 0.0 15.0" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Create hard-surface terrain -->
    <static name="Floor" type="plane">
        <material name="Steel"/>
        <look name="Gray"/>
        <world_transform xyz="0.0 0.0 -1.0" rpy="0.0 0.0 0.0"/>
    </static>
</scenario>