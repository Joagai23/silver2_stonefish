            <origin xyz="-1.62 0.98 0.28" rpy="0.0 0.0 3.14"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
		<!-- Femur L3 -->
		<link name="Femur_L3" type="model" physics="surface">
			<physical>
