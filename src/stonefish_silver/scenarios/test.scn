<?xml version="1.0"?>
<scenario>
    <!-- Robot Definition -->
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">
        <world_transform xyz="$(arg robot_pos)" rpy="0.0 0.0 0.0"/>
		<!-- Main Body -->
        <base_link name="Main_Body" type="model" physics="submerged">
			<physical>
				<mesh filename="Body.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<thickness value="0.005"/>
			</physical>
			<visual>
				<mesh filename="Body.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </base_link>

		<!-- Leg 0 -->
		<!-- Coxa L0 -->
		<link name="Coxa_L0" type="model" physics="surface">
			<physical>
				<mesh filename="Coxa.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</physical>
			<visual>
				<mesh filename="Coxa.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</link>
		<joint name="Joint_L0_Coxa" type="revolute">
            <parent name="Main_Body"/>
            <child name="Coxa_L0"/>
            <origin xyz="1.62 0.98 0.28" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
        </joint>
		<!-- Femur L0 -->
		<link name="Femur_L0" type="model" physics="surface">
			<physical>
				<mesh filename="Femur.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</physical>
			<visual>
				<mesh filename="Femur.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</link>
		<joint name="Joint_L0_Femur" type="revolute">
            <parent name="Coxa_L0"/>
            <child name="Femur_L0"/>
            <origin xyz="0.55 0.01 0.7" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
		<!-- Tibia L0 -->
		<link name="Tibia_L0" type="model" physics="surface">
			<physical>
				<mesh filename="Tibia.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</physical>
			<visual>
				<mesh filename="Tibia.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</link>
		<joint name="Joint_L0_Tibia" type="revolute">
            <parent name="Femur_L0"/>
            <child name="Tibia_L0"/>
            <origin xyz="1.85 -0.04 0.23" rpy="0.0 1.70 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

		<!-- Leg 1 -->
		<!-- Coxa L1 -->
		<link name="Coxa_L1" type="model" physics="surface">
