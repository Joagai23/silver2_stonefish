				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</physical>
			<visual>
				<mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</link>
		<joint name="Joint_L3_Tibia" type="revolute">
            <parent name="Femur_L3"/>
            <child name="Tibia_L3"/>
            <origin xyz="1.85 -0.03 0.23" rpy="0.0 1.70 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

		<!-- Leg 4 -->
		<!-- Coxa L4 -->
		<link name="Coxa_L4" type="model" physics="surface">
			<physical>
				<mesh filename="Coxa_Mirrored.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
