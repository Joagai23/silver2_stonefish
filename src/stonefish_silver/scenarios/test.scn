            <axis xyz="0.0 1.0 0.0"/>
        </joint>
		<!-- Tibia L2 -->
		<link name="Tibia_L2" type="model" physics="surface">
			<physical>
				<mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</physical>
			<visual>
				<mesh filename="Tibia_Mirrored.obj" scale="1.0"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			</visual>
			<material name="Fiberglass"/>
			<look name="Silver"/>
			<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
