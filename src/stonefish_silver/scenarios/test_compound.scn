<?xml version="1.0"?>
<scenario>
    <!-- Robot Definition -->
    <robot name="$(arg robot_name)" fixed="false" self_collisions="false">
        <world_transform xyz="$(arg robot_pos)" rpy="0.0 0.0 0.0"/>
		<!-- Main Body -->
        <base_link name="base_link" type="compound" physics="submerged">
            <external_part name="Body" type="model" physics="submerged">
				<physical>
					<mesh filename="Body.obj" scale="1"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
					<thickness value="0.005"/>
				</physical>
				<visual>
					<mesh filename="Body.obj" scale="1"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Fiberglass"/>
				<look name="Silver"/>
				<compound_transform rpy="0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
        </base_link>
		<!-- Leg 0 -->
        <!-- Coxa L0 -->
    </robot>
</scenario>